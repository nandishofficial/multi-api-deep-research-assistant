{
  "name": "multi-api-deep-research-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Deep multi-API research assistant: OpenAI Deep Research + Gemini Deep Research, PDF reports delivered by email.",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "worker": "tsx --conditions=react-server scripts/worker.ts",
    "sample-report": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/sample-report.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@google/genai": "^2.27.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "fontkit": "^2.0.4",
    "marked": "^18.0.14",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "openai": "^7.27.0",
    "pdfmake": "^0.3.11",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
