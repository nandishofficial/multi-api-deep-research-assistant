# -----------------------------------------------------------------------------
# Deep Research Assistant — environment variables
# Copy to .env.local for `npm run dev`. Only the first block is required for a
# real deployment; everything else has sensible defaults.
# -----------------------------------------------------------------------------

# --- Required for production ---------------------------------------------------

# Postgres connection string. For zero-setup local runs use an embedded database:
#   DATABASE_URL=pglite://./.data/pglite      (on disk)   or   pglite://memory
DATABASE_URL=postgres://postgres:postgres@localhost:5432/research

# Public URL of the app (used for OAuth callbacks and links in emails)
BETTER_AUTH_URL=http://localhost:3000
# Random 32+ character string: `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Provider API keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- OpenAI ----------------------------------------------------------------------

# Deep research model, tried first. If the API reports it unavailable (e.g. retired),
# the fallback models are tried in order with web search + high reasoning effort.
OPENAI_DEEP_RESEARCH_MODEL=o3-deep-research
OPENAI_DEEP_RESEARCH_FALLBACK_MODELS=gpt-5.5
# Fast model for refinement questions, brief rewriting and the report summary
OPENAI_REFINEMENT_MODEL=gpt-5.4-mini
OPENAI_SUMMARY_MODEL=gpt-5.4-mini
# Optional cap on tool calls per deep research run (controls cost/latency)
# OPENAI_MAX_TOOL_CALLS=

# --- Gemini ----------------------------------------------------------------------

# Gemini Deep Research agent (Interactions API) and fallbacks, tried in order
GEMINI_DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
GEMINI_DEEP_RESEARCH_FALLBACK_AGENTS=deep-research-pro-preview-12-2025

# --- Email -----------------------------------------------------------------------

# gmail   — send from the signed-in user's own Gmail to themselves (gmail.send scope)
# resend  — Resend HTTP API (needs RESEND_API_KEY + EMAIL_FROM on a verified domain)
# smtp    — any SMTP server (needs SMTP_URL + EMAIL_FROM)
# console — write .eml + PDF to .data/outbox (local development)
EMAIL_PROVIDER=gmail
# EMAIL_FROM="Deep Research <reports@yourdomain.com>"
# RESEND_API_KEY=
# SMTP_URL=smtps://user:pass@smtp.example.com:465

# --- Orchestration ---------------------------------------------------------------

# inline   — background worker runs inside the web server (Render, Railway, Docker)
# external — run `npm run worker` as a separate process
# off      — rely on /api/cron/tick + request-triggered kicks (serverless)
WORKER_MODE=inline
WORKER_POLL_INTERVAL_MS=5000
PROVIDER_POLL_INTERVAL_MS=15000
PROVIDER_TIMEOUT_MINUTES=75
# Bearer token for POST /api/cron/tick
CRON_SECRET=
# Apply DB migrations automatically on boot (default true)
# AUTO_MIGRATE=true
# Per-user daily research limit
# MAX_RESEARCH_PER_DAY=20

# --- Demo / development ----------------------------------------------------------

# Simulated providers + refinement (no API keys or cost). Reports are clearly labelled as mock.
RESEARCH_MOCK_PROVIDERS=false
MOCK_PROVIDER_DURATION_MS=20000
# LOG_LEVEL=debug
